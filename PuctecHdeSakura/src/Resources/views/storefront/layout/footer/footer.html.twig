{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_navigation_information_links %}
	{% if loop.first %}
		{{ parent() }}
		{% block layout_footer_navigation_revocation_button %}
			{% set cmsPath = 'frontend.cms.page.full' %}
			{% set revocationRequestSnippetKey = 'footer.serviceRevocationRequestTextPage' %}
			{% set revocationRequestCmsPageId = config('core.basicInformation.revocationRequestPage') %}
			{% set showRevocationButton = config('core.basicInformation.showRevocationButton') %}

			{% if revocationRequestCmsPageId and showRevocationButton %}
				{% set revocationRequestUrl = revocationRequestCmsPageId ? path(cmsPath, { id: revocationRequestCmsPageId }) : '#' %}
				<div class="footer-revocation-button mt-4">
					{{ revocationRequestSnippetKey|trans({
                                                '%url%': revocationRequestUrl
                                            })|raw }}
				</div>
			{% endif %}
		{% endblock %}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block layout_footer_navigation_information_link %}
    {% if 'cookie' in category.translated.name|lower or (category.externalLink and 'cookie' in category.externalLink|lower) %}
        <span class="js-cookie-configuration-button">
            <button type="button" class="btn btn-link footer-link p-0 text-start" style="text-decoration: none; color: inherit; font: inherit; background: none; border: none; cursor: pointer;">
                {{ name }}
            </button>
        </span>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block layout_footer_service_menu_item %}
    {% if 'cookie' in serviceMenuItem.translated.name|lower or (serviceMenuItem.externalLink and 'cookie' in serviceMenuItem.externalLink|lower) %}
        <li class="footer-service-menu-item">
            <span class="js-cookie-configuration-button">
                <button type="button" class="btn btn-link footer-service-menu-link p-0" style="text-decoration: none; color: inherit; font: inherit; background: none; border: none; cursor: pointer;">
                    {{ serviceMenuItem.translated.name }}
                </button>
            </span>
        </li>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block layout_footer_copyright %}
	<div class="footer-copyright">
		HDESakura Theme by <a href="https://hosono.de" target="_blank">HosonoDE</a>
	</div>
	<br>
	<div class="footer-custom">
		{{ "hde_footer_custom_html"|trans|raw }}
	</div>
    <script>
        (function() {
            function triggerCookieConsent() {
                // 1. Acris Cookie Consent modal link trigger (PUCTEC)
                var acrisLink = document.getElementById('ccActivateModalLink');
                if (acrisLink) {
                    var cookieNote = document.querySelector('.acris-cookie-consent.has--accepted');
                    if (cookieNote) cookieNote.classList.remove('has--accepted');
                    acrisLink.click();
                    return true;
                }

                // 2. Acris modal element via Bootstrap
                var acrisModal = document.getElementById('ccAcivateModal');
                if (acrisModal && window.bootstrap && window.bootstrap.Modal) {
                    var modalInstance = window.bootstrap.Modal.getOrCreateInstance(acrisModal);
                    if (modalInstance) {
                        modalInstance.show();
                        return true;
                    }
                }

                // 3. Shopware native CookieConfiguration plugin
                if (window.PluginManager) {
                    var instances = window.PluginManager.getPluginInstances('CookieConfiguration');
                    if (instances && instances[0] && typeof instances[0].openOffCanvas === 'function') {
                        instances[0].openOffCanvas();
                        return true;
                    }
                }

                // 4. Fallback button click
                var btn = document.querySelector('.js-cookie-configuration-button button, [data-cookie-permission] button, #ccSettingButton');
                if (btn) {
                    btn.click();
                    return true;
                }

                return false;
            }

            window.openCookieConsentManager = triggerCookieConsent;

            document.addEventListener('click', function(e) {
                var target = e.target.closest('a, button, #cookie-banner-link, .js-cookie-configuration-button');
                if (!target) return;

                var href = target.getAttribute('href') || '';
                var text = (target.textContent || '').trim().toLowerCase();
                var isCookieLink = target.id === 'cookie-banner-link' ||
                                   target.classList.contains('js-cookie-configuration-button') ||
                                   href.indexOf('openCookieConsentManager') !== -1 ||
                                   (text.indexOf('cookie') !== -1 && (text.indexOf('einstellung') !== -1 || text.indexOf('setting') !== -1));

                if (isCookieLink) {
                    e.preventDefault();
                    var opened = triggerCookieConsent();
                    if (!opened) {
                        // Fallback: redirect to homepage with trigger parameter if modal is missing on the current page
                        window.location.href = '/?openCookieConsent=1';
                    }
                }
            });

            if (window.location.search.indexOf('openCookieConsent=1') !== -1) {
                window.addEventListener('DOMContentLoaded', function() {
                    setTimeout(function() {
                        triggerCookieConsent();
                    }, 500);
                });
            }
        })();
    </script>
{% endblock %}

{% block layout_footer_service_menu %}{% endblock %}